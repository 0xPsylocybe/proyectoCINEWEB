# Plantilla de configuración. Copia este fichero como .env y rellena los valores:
#
#     Windows:  copy .env.example .env
#     Linux:    cp .env.example .env
#
# El .env NO se sube al repositorio. Los valores de la base de datos pídeselos
# a tu compañero; la clave de TMDB la saca cada uno de su propia cuenta.

# --- Django ---
# Generar una nueva con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# Separados por comas, solo si DEBUG=False. Ej: midominio.com,www.midominio.com
DJANGO_ALLOWED_HOSTS=

# --- Base de datos (PostgreSQL en Supabase) ---
DB_NAME=postgres
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=6543

# --- TMDB ---
# Opcional: solo hace falta para importar carteles y fichas de películas.
# Se saca gratis en https://www.themoviedb.org/settings/api
# Vale tanto la API Key (v3) como el Read Access Token (v4).
TMDB_API_KEY=
